---
import { getCloudinaryUrl } from '../utils/cloudinary';
import { SERIES, formatMinutes, type SeriesKey } from '../utils/series';

export interface Props {
  recipe: {
    slug: string;
    data: {
      title: string;
      historicalFigure: string;
      mealType: string;
      cookTime: number;
      prepTime?: number;
      difficulty: string;
      description: string;
      image?: string;
      tags?: string[];
      publishDate?: Date;
    };
  };
  series?: SeriesKey;
  episodeNumber?: number;
}

const { recipe, series, episodeNumber } = Astro.props;
const { data } = recipe;
const totalTime = (data.prepTime ?? 0) + data.cookTime;
const difficultyLevel = { easy: 1, medium: 2, hard: 3 }[data.difficulty] ?? 2;
const searchText = [data.title, data.historicalFigure, data.description, ...(data.tags ?? [])].join(' ').toLowerCase();
---

<article
  class="recipe-card group relative flex flex-col rounded-2xl bg-charcoal ring-1 ring-smoke hover:ring-gold/60 overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_50px_-20px_rgba(229,192,116,0.35)]"
  data-series={series}
  data-meal={data.mealType}
  data-difficulty={data.difficulty}
  data-time={totalTime}
  data-date={data.publishDate?.getTime()}
  data-title={data.title.toLowerCase()}
  data-search={searchText}
>
  <div class="relative aspect-[4/3] overflow-hidden bg-charcoal">
    {data.image ? (
      <img
        src={getCloudinaryUrl(data.image, { width: 640, height: 480, crop: 'fill', gravity: 'auto' })}
        alt=""
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06]"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="w-full h-full grid place-items-center bg-gold text-charcoal font-display uppercase text-3xl px-6 text-center">
        {data.historicalFigure}
      </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-transparent"></div>
    <div class="absolute top-3 left-3 flex gap-1.5">
      {series && (
        <span class:list={[
          "text-[0.65rem] font-semibold uppercase tracking-[0.14em] px-2.5 py-1 rounded-full",
          series === 'nations' ? "bg-cream text-charcoal" : "bg-gold text-charcoal",
        ]}>
          {SERIES[series].short}
        </span>
      )}
      {episodeNumber !== undefined && (
        <span class="text-[0.65rem] font-semibold uppercase tracking-[0.14em] px-2.5 py-1 rounded-full bg-ink/70 backdrop-blur text-cream">
          Ep {episodeNumber}
        </span>
      )}
    </div>
    <p class="absolute bottom-3 left-4 right-4 font-serif italic text-xl text-cream leading-tight">
      {data.historicalFigure}
    </p>
  </div>

  <div class="flex flex-col flex-1 p-5">
    <h3 class="text-lg font-semibold leading-snug text-cream">
      <a href={`/recipes/${recipe.slug}`} class="after:absolute after:inset-0 focus:outline-none">
        {data.title}
      </a>
    </h3>
    <p class="mt-2 text-sm text-cream/60 line-clamp-2">{data.description}</p>

    <div class="mt-auto pt-5 flex items-center gap-4 text-xs text-cream/70">
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        {formatMinutes(totalTime)}
      </span>
      <span class="inline-flex items-center gap-1.5 capitalize" title={`Difficulty: ${data.difficulty}`}>
        <span class="flex gap-0.5" aria-hidden="true">
          {[1, 2, 3].map((n) => (
            <span class:list={["w-1.5 h-3 rounded-sm", n <= difficultyLevel ? "bg-gold" : "bg-smoke"]}></span>
          ))}
        </span>
        {data.difficulty}
      </span>
      <span class="ml-auto capitalize text-cream/50">{data.mealType}</span>
    </div>
  </div>
</article>
