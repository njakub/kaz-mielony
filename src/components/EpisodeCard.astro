---
import type { CollectionEntry } from 'astro:content';
import { SERIES, getEpisodeSeries, getEpisodeThumbnail, hasVideo, formatDate } from '../utils/series';

export interface Props {
  episode: CollectionEntry<'episodes'>;
}

const { episode } = Astro.props;
const series = getEpisodeSeries(episode);
const thumb = getEpisodeThumbnail(episode);
const live = hasVideo(episode);
---

<article
  class="episode-card group relative flex flex-col"
  data-series={series}
>
  <div class="relative aspect-video rounded-2xl overflow-hidden bg-charcoal ring-1 ring-smoke group-hover:ring-gold/60 transition-all duration-300">
    {thumb ? (
      <img src={thumb} alt="" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.05]" loading="lazy" decoding="async" />
    ) : (
      <div class="w-full h-full bg-gold"></div>
    )}
    <div class="absolute inset-0 bg-gradient-to-tr from-ink/85 via-ink/10 to-transparent"></div>
    <span class="absolute left-4 bottom-2 font-display text-6xl sm:text-7xl leading-none text-cream/95 drop-shadow-lg">
      {String(episode.data.episodeNumber).padStart(2, '0')}
    </span>
    <span class:list={[
      "absolute top-3 left-3 text-[0.65rem] font-semibold uppercase tracking-[0.14em] px-2.5 py-1 rounded-full",
      series === 'nations' ? "bg-cream text-charcoal" : "bg-gold text-charcoal",
    ]}>
      {SERIES[series].short}
    </span>
    {live ? (
      <span class="absolute right-3 bottom-3 grid place-items-center w-11 h-11 rounded-full bg-gold text-charcoal opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300" aria-hidden="true">
        <svg class="w-4 h-4 ml-0.5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5-11-6.5Z"/></svg>
      </span>
    ) : (
      <span class="absolute top-3 right-3 text-[0.65rem] font-semibold uppercase tracking-[0.14em] px-2.5 py-1 rounded-full bg-tomato text-cream">Coming soon</span>
    )}
  </div>
  <div class="pt-4">
    <p class="text-xs text-cream/50 flex items-center gap-2">
      <span class="text-gold font-medium">{episode.data.historicalFigure}</span>
      <span aria-hidden="true">·</span>
      <time datetime={episode.data.publishDate.toISOString()}>{formatDate(episode.data.publishDate)}</time>
    </p>
    <h3 class="mt-1.5 text-lg font-semibold leading-snug text-cream group-hover:text-gold transition-colors">
      <a href={`/episodes/${episode.slug}`} class="after:absolute after:inset-0 focus:outline-none">{episode.data.title}</a>
    </h3>
    <p class="mt-1.5 text-sm text-cream/55 line-clamp-2">{episode.data.description}</p>
  </div>
</article>
