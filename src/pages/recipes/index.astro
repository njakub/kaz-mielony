---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';
import RecipeCard from '../../components/RecipeCard.astro';
import { SERIES, SERIES_KEYS, getRecipeSeries, findRecipeEpisode } from '../../utils/series';

const recipes = await getCollection('recipes');
const episodes = await getCollection('episodes');
const sortedRecipes = recipes.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const seriesCounts = Object.fromEntries(
  SERIES_KEYS.map((k) => [k, recipes.filter((r) => getRecipeSeries(r, episodes) === k).length])
);

const filterGroups = [
  {
    key: 'series',
    label: 'Series',
    options: [{ value: 'all', label: 'All', count: recipes.length }, ...SERIES_KEYS.map((k) => ({ value: k, label: SERIES[k].short, count: seriesCounts[k] }))],
  },
  {
    key: 'meal',
    label: 'Meal',
    options: [{ value: 'all', label: 'Any' }, ...['breakfast', 'lunch', 'dinner', 'dessert']
      .filter((m) => recipes.some((r) => r.data.mealType === m))
      .map((m) => ({ value: m, label: m }))],
  },
  {
    key: 'difficulty',
    label: 'Difficulty',
    options: [{ value: 'all', label: 'Any' }, ...['easy', 'medium', 'hard'].map((d) => ({ value: d, label: d }))],
  },
];
---

<Layout title="All Recipes" description="Every recipe from Kaz Cooks History and Kaz Cooks Nations — searchable by figure, country, meal and difficulty.">
  <header class="relative overflow-hidden border-b border-smoke">
    <div class="absolute -top-40 -right-40 w-[34rem] h-[34rem] rounded-full bg-gold/10 blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-10">
      <p class="eyebrow">The cookbook</p>
      <h1 class="mt-4 font-display uppercase text-6xl sm:text-8xl leading-[0.88]">
        Every recipe<span class="text-gold">.</span>
      </h1>
      <p class="mt-5 text-lg text-cream/65 max-w-2xl">
        {recipes.length} dishes from history's dinner tables and the world's national kitchens — tested in a real home kitchen, written up so you can cook them too.
      </p>
    </div>
  </header>

  <!-- Filter bar -->
  <div class="sticky top-16 z-30 bg-ink/85 backdrop-blur-xl border-b border-smoke">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-wrap items-center gap-3">
      <label class="relative flex-1 min-w-0 sm:flex-none sm:w-80">
        <span class="sr-only">Search recipes</span>
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-cream/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input
          id="recipe-search"
          type="search"
          placeholder="Search Churchill, curry, lamb…"
          autocomplete="off"
          class="w-full bg-graphite/70 ring-1 ring-smoke focus:ring-gold focus:outline-none rounded-full pl-11 pr-4 py-2.5 text-sm placeholder:text-cream/35"
        />
      </label>

      <div class="order-last basis-full flex gap-5 overflow-x-auto no-scrollbar -mx-4 px-4 sm:mx-0 sm:px-0">
        {filterGroups.map((group) => (
          <div class="flex items-center gap-1.5 shrink-0" role="radiogroup" aria-label={group.label}>
            <span class="text-[0.65rem] uppercase tracking-label text-cream/40 mr-1">{group.label}</span>
            {group.options.map((opt, i) => (
              <button
                type="button"
                role="radio"
                aria-checked={i === 0 ? 'true' : 'false'}
                data-filter={group.key}
                data-value={opt.value}
                class="chip capitalize text-sm px-3 py-1.5 rounded-full ring-1 ring-smoke text-cream/70 hover:text-cream transition-colors whitespace-nowrap"
              >
                {opt.label}{'count' in opt && <span class="ml-1 opacity-50">{opt.count}</span>}
              </button>
            ))}
          </div>
        ))}
      </div>

      <label class="flex items-center gap-2 ml-auto shrink-0 text-sm text-cream/60">
        Sort
        <select id="recipe-sort" class="bg-graphite/70 ring-1 ring-smoke focus:ring-gold focus:outline-none rounded-full px-3 py-2 text-cream text-sm">
          <option value="newest">Newest</option>
          <option value="quickest">Quickest</option>
          <option value="az">A–Z</option>
        </select>
      </label>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
    <p class="text-sm text-cream/50 mb-6" aria-live="polite">
      Showing <span id="recipe-count" class="text-cream font-semibold">{recipes.length}</span> of {recipes.length} recipes
    </p>

    <div id="recipe-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedRecipes.map((recipe) => (
        <RecipeCard
          recipe={recipe}
          series={getRecipeSeries(recipe, episodes)}
          episodeNumber={findRecipeEpisode(recipe, episodes)?.data.episodeNumber}
        />
      ))}
    </div>

    <div id="recipe-empty" class="hidden text-center py-24">
      <p class="font-display uppercase text-5xl text-cream/80">Nothing on the menu</p>
      <p class="mt-3 text-cream/50">No recipes match those filters. Even Columbus found something eventually.</p>
      <button type="button" id="recipe-reset" class="mt-6 bg-gold text-charcoal font-semibold px-5 py-2.5 rounded-full hover:bg-gold-light">Clear filters</button>
    </div>
  </div>
</Layout>

<style>
  .chip[aria-checked="true"] { background: #e5c074; color: #282828; --tw-ring-color: #e5c074; font-weight: 600; }
</style>

<script>
  const grid = document.getElementById('recipe-grid')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('.recipe-card')];
  const search = document.getElementById('recipe-search') as HTMLInputElement;
  const sort = document.getElementById('recipe-sort') as HTMLSelectElement;
  const countEl = document.getElementById('recipe-count')!;
  const empty = document.getElementById('recipe-empty')!;

  const state: Record<string, string> = { series: 'all', meal: 'all', difficulty: 'all' };
  const datasetKey: Record<string, string> = { series: 'series', meal: 'meal', difficulty: 'difficulty' };

  function setChip(group: string, value: string) {
    state[group] = value;
    document.querySelectorAll<HTMLElement>(`[data-filter="${group}"]`).forEach((b) =>
      b.setAttribute('aria-checked', String(b.dataset.value === value))
    );
  }

  function apply() {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    cards.forEach((card) => {
      const matches =
        Object.entries(state).every(([k, v]) => v === 'all' || card.dataset[datasetKey[k]] === v) &&
        (!q || q.split(/\s+/).every((word) => card.dataset.search!.includes(word)));
      card.hidden = !matches;
      if (matches) shown++;
    });

    const ordered = [...cards].sort((a, b) => {
      if (sort.value === 'quickest') return Number(a.dataset.time) - Number(b.dataset.time);
      if (sort.value === 'az') return a.dataset.title!.localeCompare(b.dataset.title!);
      return Number(b.dataset.date) - Number(a.dataset.date);
    });
    ordered.forEach((c) => grid.appendChild(c));

    countEl.textContent = String(shown);
    empty.classList.toggle('hidden', shown > 0);

    const params = new URLSearchParams();
    if (state.series !== 'all') params.set('series', state.series);
    if (state.meal !== 'all') params.set('meal', state.meal);
    if (state.difficulty !== 'all') params.set('difficulty', state.difficulty);
    if (q) params.set('q', q);
    if (sort.value !== 'newest') params.set('sort', sort.value);
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  document.querySelectorAll<HTMLElement>('[data-filter]').forEach((btn) =>
    btn.addEventListener('click', () => {
      setChip(btn.dataset.filter!, btn.dataset.value!);
      apply();
    })
  );
  search.addEventListener('input', apply);
  sort.addEventListener('change', apply);
  document.getElementById('recipe-reset')?.addEventListener('click', () => {
    Object.keys(state).forEach((k) => setChip(k, 'all'));
    search.value = '';
    apply();
  });

  // Restore from URL (?series=nations etc.)
  const params = new URLSearchParams(location.search);
  Object.keys(state).forEach((k) => {
    const v = params.get(k);
    if (v && document.querySelector(`[data-filter="${k}"][data-value="${v}"]`)) setChip(k, v);
  });
  search.value = params.get('q') ?? '';
  if (params.get('sort')) sort.value = params.get('sort')!;
  if ([...params.keys()].length) apply();
</script>
