---
import Layout from '../components/Layout.astro';
import { getCollection } from 'astro:content';
import RecipeCard from '../components/RecipeCard.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import SoundBites from '../components/SoundBites.astro';
import { getShorts, getAudienceStats, formatCompact } from '../utils/youtube';
import { getCloudinaryUrl } from '../utils/cloudinary';
import {
  SERIES,
  SERIES_KEYS,
  getEpisodeSeries,
  getEpisodeThumbnail,
  getRecipeSeries,
  findRecipeEpisode,
  hasVideo,
  formatDate,
  formatMinutes,
} from '../utils/series';

const recipes = await getCollection('recipes');
const episodes = await getCollection('episodes');

const byNewest = <T extends { data: { publishDate: Date } }>(a: T, b: T) =>
  b.data.publishDate.getTime() - a.data.publishDate.getTime();

const sortedEpisodes = [...episodes].sort((a, b) => byNewest(a, b) || b.data.episodeNumber - a.data.episodeNumber);
const latestRecipes = [...recipes].sort(byNewest).slice(0, 6);

const featured = sortedEpisodes.find(hasVideo) ?? sortedEpisodes[0];
const featuredRecipes = recipes.filter((r) => featured.data.relatedRecipes.includes(r.slug));
const upcoming = sortedEpisodes.filter((e) => !hasVideo(e)).slice(0, 2);

const seriesStats = SERIES_KEYS.map((key) => {
  const eps = sortedEpisodes.filter((e) => getEpisodeSeries(e) === key);
  return { ...SERIES[key], episodes: eps, recipeCount: recipes.filter((r) => getRecipeSeries(r, episodes) === key).length };
});
const nationsCount = seriesStats.find((s) => s.key === 'nations')?.episodes.length ?? 0;

const marqueeNames = [...new Set([...episodes].sort((a, b) => a.data.episodeNumber - b.data.episodeNumber).map((e) => e.data.historicalFigure))];

const rouletteItems = recipes.map((r) => ({
  href: `/recipes/${r.slug}`,
  title: r.data.title,
  figure: r.data.historicalFigure,
  series: getRecipeSeries(r, episodes),
  time: formatMinutes(r.data.prepTime + r.data.cookTime),
  image: r.data.image ? getCloudinaryUrl(r.data.image, { width: 720, height: 540, gravity: 'auto' }) : null,
}));

// One rotating word per series/playlist
const rotatingWords = SERIES_KEYS.map((k) => SERIES[k].short);

const shorts = await getShorts();
const audience = await getAudienceStats();

const heroStats = [
  { label: 'Episodes', count: episodes.length, display: String(episodes.length) },
  { label: 'Recipes', count: recipes.length, display: String(recipes.length) },
  audience.totalViews > 0
    ? { label: 'Total views', count: undefined, display: formatCompact(audience.totalViews) }
    : { label: 'Nations', count: nationsCount, display: String(nationsCount) },
];
---

<Layout title="Home">
  <!-- ─── Hero ──────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-charcoal">
    <div class="absolute top-0 lg:inset-y-0 left-0 w-full lg:w-[36%] h-[17rem] sm:h-[20rem] lg:h-auto bg-gold" aria-hidden="true"></div>
    <div class="absolute inset-0 opacity-[0.07] pointer-events-none" style="background-image: radial-gradient(circle at 1px 1px, #fbf7ef 1px, transparent 0); background-size: 22px 22px;" aria-hidden="true"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-16 lg:pt-20 lg:pb-28 grid lg:grid-cols-[36%_1fr] gap-10 lg:gap-0 items-center">
      <div class="relative flex justify-center lg:justify-end lg:pr-0">
        <div class="relative w-56 sm:w-72 lg:w-[22rem] lg:translate-x-16 rotate-[-4deg] hover:rotate-0 transition-transform duration-500">
          <div class="rounded-[1.75rem] bg-cream p-2.5 shadow-[0_30px_60px_-20px_rgba(0,0,0,0.6)]">
            <img src="/images/kaz.jpg" alt="Kaz, grinning, in a black cap" class="rounded-[1.25rem] aspect-square object-cover w-full" width="600" height="600" />
          </div>
          <span class="absolute -bottom-4 -left-4 sm:-left-6 rotate-[-8deg] bg-charcoal text-gold font-display uppercase tracking-wide text-lg px-4 py-1.5 rounded-full ring-2 ring-gold shadow-lg">
            Hey, it's Kaz
          </span>
        </div>
      </div>

      <div class="lg:pl-28">
        <p class="eyebrow">New video <span class="text-cream/40">|</span> Every week</p>
        <h1 class="mt-5 font-display uppercase leading-[0.86] text-[clamp(4rem,11vw,9.5rem)] tracking-tight">
          <span class="block text-cream">Kaz cooks</span>
          <span class="block text-gold h-[0.9em] overflow-hidden" aria-live="polite">
            <span id="rotating-word" class="inline-block">{rotatingWords[0]}</span>
          </span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-cream/70 max-w-xl leading-relaxed">
          A curious home cook and hungry history enthusiast recreating the go-to meals of famous
          <span class="font-serif italic text-cream text-[1.15em]">(and sometimes infamous)</span> figures — and the national dishes of the world.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/recipes" class="group inline-flex items-center gap-2 bg-gold text-charcoal font-semibold px-6 py-3.5 rounded-full hover:bg-gold-light transition-colors">
            Find a recipe
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href={`/episodes/${featured.slug}`} class="inline-flex items-center gap-2 ring-1 ring-cream/30 hover:ring-gold hover:text-gold font-semibold px-6 py-3.5 rounded-full transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5-11-6.5Z"/></svg>
            Watch the latest
          </a>
        </div>

        <dl class="mt-12 grid grid-cols-3 max-w-lg divide-x divide-smoke border-y border-smoke">
          {heroStats.map((stat) => (
            <div class="py-4 px-4 first:pl-0">
              <dt class="text-[0.68rem] uppercase tracking-label text-cream/50">{stat.label}</dt>
              <dd class="font-display text-4xl text-cream mt-1" data-count={stat.count}>{stat.display}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ─── Marquee ───────────────────────────────────────── -->
  <div class="relative border-y border-smoke bg-ink py-5 overflow-hidden select-none" aria-hidden="true">
    <div class="flex w-max animate-marquee hover:[animation-play-state:paused]">
      {[0, 1].map(() => (
        <ul class="flex shrink-0 items-center">
          {marqueeNames.map((name) => (
            <li class="flex items-center font-display uppercase text-3xl sm:text-4xl whitespace-nowrap">
              <span class="marquee-word px-6">{name}</span>
              <span class="w-2.5 h-2.5 rounded-full bg-gold"></span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <!-- ─── Latest episode ────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24">
    <div class="grid lg:grid-cols-[1.5fr_1fr] gap-10 lg:gap-14 items-center" data-reveal>
      <VideoEmbed videoId={featured.data.youtubeId} title={featured.data.title} thumbnail={getEpisodeThumbnail(featured)} />
      <div>
        <p class="eyebrow">Latest episode · {SERIES[getEpisodeSeries(featured)].name}</p>
        <h2 class="mt-4 font-display uppercase text-5xl sm:text-6xl leading-[0.92]">
          <a href={`/episodes/${featured.slug}`} class="hover:text-gold transition-colors">{featured.data.title}</a>
        </h2>
        <p class="mt-3 text-sm text-cream/50">
          Episode {featured.data.episodeNumber} · {featured.data.historicalFigure} · {formatDate(featured.data.publishDate)}
        </p>
        <p class="mt-5 text-cream/70 leading-relaxed">{featured.data.description}</p>
        {featuredRecipes.length > 0 && (
          <div class="mt-7 space-y-2">
            <p class="text-xs uppercase tracking-label text-cream/50">On the menu</p>
            {featuredRecipes.map((r) => (
              <a href={`/recipes/${r.slug}`} class="group flex items-center justify-between gap-4 rounded-xl bg-graphite/60 ring-1 ring-smoke hover:ring-gold px-4 py-3 transition-colors">
                <span class="font-medium">{r.data.title}</span>
                <span class="text-gold text-sm font-semibold shrink-0 group-hover:translate-x-1 transition-transform">Get the recipe →</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>

    {upcoming.length > 0 && (
      <div class="mt-14 rounded-2xl border border-dashed border-smoke bg-[repeating-linear-gradient(135deg,transparent_0_14px,rgba(255,255,255,0.02)_14px_28px)] p-5 sm:p-6" data-reveal>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
          <p class="font-display uppercase text-2xl text-cream">Coming up <span class="text-tomato">●</span></p>
          {upcoming.map((e) => (
            <a href={`/episodes/${e.slug}`} class="group flex items-center gap-3 rounded-full bg-graphite ring-1 ring-smoke hover:ring-gold pl-1.5 pr-4 py-1.5 transition-colors">
              {getEpisodeThumbnail(e) && <img src={getEpisodeThumbnail(e)} alt="" class="w-9 h-9 rounded-full object-cover" loading="lazy" />}
              <span class="text-sm"><span class="text-cream/50">Ep {e.data.episodeNumber}</span> · <span class="font-medium group-hover:text-gold">{e.data.historicalFigure}</span></span>
            </a>
          ))}
          <p class="text-sm text-cream/50 sm:ml-auto">The recipes are already up — cook ahead of the video.</p>
        </div>
      </div>
    )}
  </section>

  <!-- ─── Sound bites (Shorts) ──────────────────────────── -->
  {shorts.length > 0 && (
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28" data-reveal>
      <SoundBites shorts={shorts} />
    </div>
  )}

  <!-- ─── Series ────────────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-10" data-reveal>
      <div>
        <p class="eyebrow">Pick your series</p>
        <h2 class="mt-3 font-display uppercase text-5xl sm:text-6xl leading-[0.92]">Two ways to<br class="sm:hidden" /> eat the world</h2>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-5">
      {seriesStats.map((s, i) => {
        const light = s.key === 'nations';
        return (
          <article
            class:list={[
              "relative overflow-hidden rounded-3xl p-7 sm:p-10 flex flex-col min-h-[30rem]",
              light ? "bg-gold text-charcoal" : "bg-charcoal ring-1 ring-smoke text-cream",
            ]}
            data-reveal
            style={`--reveal-delay:${i * 120}ms`}
          >
            <p class:list={["text-xs font-semibold uppercase tracking-label", light ? "text-charcoal/70" : "text-gold"]}>
              Series {String(i + 1).padStart(2, '0')} · {s.episodes.length} episodes · {s.recipeCount} recipes
            </p>
            <h3 class="mt-4 font-display uppercase text-5xl sm:text-7xl leading-[0.88]">
              Kaz cooks<br /><span class={light ? 'text-cream' : 'text-gold'}>{s.short}</span>
            </h3>
            <p class:list={["mt-4 max-w-md", light ? "text-charcoal/75" : "text-cream/65"]}>{s.tagline}</p>

            {light ? (
              <ul class="mt-8 flex flex-wrap gap-2">
                {[...s.episodes].reverse().map((e, n) => (
                  <li>
                    <a href={`/episodes/${e.slug}`} class="stamp group inline-flex flex-col items-center justify-center w-[5.5rem] h-[5.5rem] rounded-xl border-2 border-dashed border-charcoal/70 hover:bg-charcoal hover:text-gold hover:border-charcoal transition-all hover:-rotate-6">
                      <span class="text-[0.6rem] font-semibold tracking-[0.14em]">NO. {String(n + 1).padStart(2, '0')}</span>
                      <span class="font-display uppercase text-sm leading-tight text-center px-1 mt-0.5">{e.data.historicalFigure}</span>
                    </a>
                  </li>
                ))}
                <li class="inline-flex items-center justify-center w-[5.5rem] h-[5.5rem] rounded-xl border-2 border-dashed border-charcoal/30 text-charcoal/50 text-xs font-semibold text-center">Next<br />country?</li>
              </ul>
            ) : (
              <div class="mt-8 grid grid-cols-4 gap-2">
                {s.episodes.slice(0, 8).map((e) => (
                  <a href={`/episodes/${e.slug}`} class="group relative aspect-square rounded-xl overflow-hidden bg-graphite" title={e.data.historicalFigure}>
                    {getEpisodeThumbnail(e) && <img src={getEpisodeThumbnail(e)} alt={e.data.historicalFigure} class="w-full h-full object-cover grayscale-[40%] group-hover:grayscale-0 group-hover:scale-110 transition-all duration-500" loading="lazy" />}
                  </a>
                ))}
              </div>
            )}

            <div class="mt-auto pt-9 flex flex-wrap gap-2.5">
              <a href={`/episodes?series=${s.key}`} class:list={["font-semibold text-sm px-5 py-3 rounded-full transition-colors", light ? "bg-charcoal text-cream hover:bg-ink" : "bg-gold text-charcoal hover:bg-gold-light"]}>Episodes</a>
              <a href={`/recipes?series=${s.key}`} class:list={["font-semibold text-sm px-5 py-3 rounded-full ring-1 transition-colors", light ? "ring-charcoal/40 hover:bg-charcoal/10" : "ring-cream/25 hover:ring-gold hover:text-gold"]}>Recipes</a>
              <a href={s.playlist} target="_blank" rel="noopener" class:list={["font-semibold text-sm px-5 py-3 rounded-full transition-colors", light ? "hover:bg-charcoal/10" : "hover:text-gold"]}>YouTube playlist ↗</a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- ─── Latest recipes ────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-10" data-reveal>
      <div>
        <p class="eyebrow">Fresh from the kitchen</p>
        <h2 class="mt-3 font-display uppercase text-5xl sm:text-6xl leading-[0.92]">Latest recipes</h2>
      </div>
      <a href="/recipes" class="group inline-flex items-center gap-2 font-semibold text-gold hover:text-gold-light">
        All {recipes.length} recipes
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {latestRecipes.map((recipe, i) => {
        const ep = findRecipeEpisode(recipe, episodes);
        return (
          <div data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
            <RecipeCard recipe={recipe} series={getRecipeSeries(recipe, episodes)} episodeNumber={ep?.data.episodeNumber} />
          </div>
        );
      })}
    </div>
  </section>

  <!-- ─── Roulette ──────────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28">
    <div class="relative overflow-hidden rounded-3xl bg-cream text-charcoal p-7 sm:p-12 grid lg:grid-cols-2 gap-10 items-center" data-reveal>
      <div class="absolute -right-24 -top-24 w-80 h-80 rounded-full bg-gold/40 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="relative">
        <p class="eyebrow !text-gold-deep">Recipe roulette</p>
        <h2 class="mt-3 font-display uppercase text-5xl sm:text-7xl leading-[0.88]">Can't decide<br />what to cook?</h2>
        <p class="mt-5 text-charcoal/70 max-w-md text-lg">Let history choose. Spin the wheel and dinner's sorted — whether that's a rock star's burrito or a 15th-century ship's biscuit.</p>
        <div class="mt-7 flex flex-wrap items-center gap-2" role="radiogroup" aria-label="Series">
          {[{ key: 'all', label: 'Anything' }, ...SERIES_KEYS.map((k) => ({ key: k, label: SERIES[k].short }))].map((opt, i) => (
            <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-roulette-filter={opt.key} class="roulette-filter text-sm font-semibold px-4 py-2 rounded-full ring-1 ring-charcoal/20 transition-colors">
              {opt.label}
            </button>
          ))}
        </div>
        <button type="button" id="roulette-spin" class="mt-6 group inline-flex items-center gap-3 bg-charcoal text-cream font-display uppercase text-2xl tracking-wide pl-6 pr-7 py-4 rounded-full hover:bg-ink transition-colors">
          <svg id="roulette-die" class="w-7 h-7 text-gold transition-transform duration-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8" cy="8" r="1.3" fill="currentColor"/><circle cx="16" cy="16" r="1.3" fill="currentColor"/><circle cx="12" cy="12" r="1.3" fill="currentColor"/><circle cx="16" cy="8" r="1.3" fill="currentColor"/><circle cx="8" cy="16" r="1.3" fill="currentColor"/></svg>
          Spin it
        </button>
      </div>

      <div class="relative">
        <a id="roulette-card" href={rouletteItems[0].href} class="block rounded-2xl overflow-hidden bg-charcoal text-cream shadow-[0_30px_60px_-25px_rgba(0,0,0,0.5)] rotate-[1.5deg] transition-transform hover:rotate-0">
          <div class="relative aspect-[4/3] bg-graphite">
            <img id="roulette-img" src={rouletteItems[0].image ?? ''} alt="" class="w-full h-full object-cover transition-[filter] duration-150" />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/10 to-transparent"></div>
            <div class="absolute bottom-0 inset-x-0 p-6">
              <p id="roulette-figure" class="font-serif italic text-xl text-gold">{rouletteItems[0].figure}</p>
              <p id="roulette-title" class="mt-1 font-display uppercase text-3xl sm:text-4xl leading-none">{rouletteItems[0].title}</p>
            </div>
          </div>
          <div class="flex items-center justify-between px-6 py-4 text-sm">
            <span id="roulette-time" class="text-cream/60">{rouletteItems[0].time}</span>
            <span id="roulette-cta" class="font-semibold text-gold opacity-0 transition-opacity">Let's cook it →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── Audience ──────────────────────────────────────── -->
  {audience.platforms.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28" data-reveal>
      <div class="relative overflow-hidden rounded-3xl bg-charcoal ring-1 ring-smoke">
        <div class="absolute inset-y-0 left-0 w-2 bg-gold" aria-hidden="true"></div>
        <div class="grid lg:grid-cols-[1.1fr_1.4fr] gap-px bg-smoke">
          <div class="bg-charcoal p-8 sm:p-10">
            <p class="eyebrow">By the numbers</p>
            <p class="mt-5 font-display uppercase text-[clamp(4rem,10vw,7.5rem)] leading-[0.85] text-gold">
              {formatCompact(audience.totalViews)}
            </p>
            <p class="mt-3 font-display uppercase text-3xl leading-none">Views and counting</p>
            <p class="mt-4 text-cream/55 max-w-sm">Across every platform Kaz cooks on. Thanks for watching — and for cooking along.</p>
          </div>
          <ul class:list={["grid gap-px bg-smoke", { 2: "sm:grid-cols-2", 3: "sm:grid-cols-3" }[audience.platforms.length]]}>
            {audience.platforms.map((p) => (
              <li class="bg-charcoal">
                <a href={p.url} target="_blank" rel="noopener" class="group flex flex-col h-full p-7 sm:p-8 hover:bg-graphite transition-colors">
                  <span class="flex items-center justify-between text-sm font-semibold">
                    {p.label}
                    <span class="text-cream/40 group-hover:text-gold transition-colors">↗</span>
                  </span>
                  {p.views !== undefined && (
                    <span class="mt-6">
                      <span class="block font-display text-5xl leading-none">{formatCompact(p.views)}</span>
                      <span class="text-xs uppercase tracking-label text-cream/45">views</span>
                    </span>
                  )}
                  {p.followers !== undefined && (
                    <span class="mt-4 text-sm text-cream/60"><span class="font-semibold text-cream">{formatCompact(p.followers)}</span> {p.followerNoun}</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- ─── About strip ───────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 text-center" data-reveal>
    <img src="/images/kaz.jpg" alt="" class="w-20 h-20 rounded-full object-cover mx-auto ring-4 ring-gold" loading="lazy" />
    <blockquote class="mt-8 font-serif text-3xl sm:text-5xl leading-tight text-cream">
      “From scientists and movie stars to dictators and revolutionaries — join me as I dive <span class="italic text-gold">fork-first</span> into their world.”
    </blockquote>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href="https://www.youtube.com/@KazMielony?sub_confirmation=1" target="_blank" rel="noopener" class="bg-gold text-charcoal font-semibold px-6 py-3.5 rounded-full hover:bg-gold-light transition-colors">Subscribe on YouTube</a>
      <a href="/about" class="ring-1 ring-cream/30 hover:ring-gold hover:text-gold font-semibold px-6 py-3.5 rounded-full transition-colors">More about Kaz</a>
    </div>
  </section>
</Layout>

<style>
  .marquee-word { color: transparent; -webkit-text-stroke: 1px rgba(251, 247, 239, 0.55); transition: color 0.2s; }
  .marquee-word:hover { color: #e5c074; -webkit-text-stroke-color: #e5c074; }
  .roulette-filter[aria-checked="true"] { background: #282828; color: #fbf7ef; --tw-ring-color: #282828; }
  .roulette-filter[aria-checked="false"]:hover { background: rgba(40, 40, 40, 0.06); }
  .stamp { transform: rotate(var(--r, 0deg)); }
  .stamp:nth-child(odd) { --r: -2deg; }
</style>

<script define:vars={{ rotatingWords, rouletteItems }}>
  // Rotating hero word
  const wordEl = document.getElementById('rotating-word');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (wordEl && !reduced) {
    let i = 0;
    setInterval(() => {
      i = (i + 1) % rotatingWords.length;
      wordEl.classList.remove('animate-word-in');
      void wordEl.offsetWidth;
      wordEl.textContent = rotatingWords[i];
      wordEl.classList.add('animate-word-in');
    }, 2400);
  }

  // Stat count-up
  document.querySelectorAll('[data-count]').forEach((el) => {
    const target = Number(el.dataset.count);
    if (reduced || !target) return;
    let n = 0;
    el.textContent = '0';
    const step = () => {
      n += Math.max(1, Math.ceil((target - n) / 8));
      el.textContent = String(Math.min(n, target));
      if (n < target) setTimeout(step, 45);
    };
    setTimeout(step, 400);
  });

  // Recipe roulette
  let filter = 'all';
  let spinning = false;
  const card = document.getElementById('roulette-card');
  const img = document.getElementById('roulette-img');
  const title = document.getElementById('roulette-title');
  const figure = document.getElementById('roulette-figure');
  const time = document.getElementById('roulette-time');
  const cta = document.getElementById('roulette-cta');
  const die = document.getElementById('roulette-die');

  // Warm the image cache so the spin doesn't flicker
  rouletteItems.forEach((r) => { if (r.image) new Image().src = r.image; });

  const show = (r, blur) => {
    card.href = r.href;
    if (r.image) img.src = r.image;
    img.style.filter = blur ? 'blur(3px) saturate(1.3)' : '';
    title.textContent = r.title;
    figure.textContent = r.figure;
    time.textContent = r.time;
  };

  document.querySelectorAll('[data-roulette-filter]').forEach((btn) => {
    btn.addEventListener('click', () => {
      filter = btn.dataset.rouletteFilter;
      document.querySelectorAll('[data-roulette-filter]').forEach((b) => b.setAttribute('aria-checked', String(b === btn)));
    });
  });

  let rotation = 0;
  document.getElementById('roulette-spin')?.addEventListener('click', () => {
    if (spinning) return;
    const pool = rouletteItems.filter((r) => filter === 'all' || r.series === filter);
    if (!pool.length) return;
    spinning = true;
    cta.style.opacity = '0';
    rotation += 720;
    die.style.transform = `rotate(${rotation}deg)`;
    const final = pool[Math.floor(Math.random() * pool.length)];
    const ticks = reduced ? 0 : 16;
    let t = 0;
    const tick = () => {
      if (t >= ticks) {
        show(final, false);
        cta.style.opacity = '1';
        spinning = false;
        return;
      }
      show(pool[Math.floor(Math.random() * pool.length)], true);
      t++;
      setTimeout(tick, 40 + t * t * 1.6);
    };
    tick();
  });
</script>
