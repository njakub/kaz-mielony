---
import Layout from "../components/Layout.astro";
import TierList, { type TierItem } from "../components/TierList.astro";

// Fetch tier icons from Cloudinary at build time
const cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME || "dfxheaozx";
const apiKey = import.meta.env.CLOUDINARY_API_KEY;
const apiSecret = import.meta.env.CLOUDINARY_API_SECRET;
const passwordHash = import.meta.env.PUBLIC_TIER_PASSWORD_HASH ?? "";

type CloudinaryResource = { public_id: string; secure_url: string };

async function fetchIcons(prefix: string): Promise<CloudinaryResource[]> {
  const creds = btoa(`${apiKey}:${apiSecret}`);
  const url = `https://api.cloudinary.com/v1_1/${cloudName}/resources/image?type=upload&prefix=${prefix}&max_results=500`;
  const res = await fetch(url, { headers: { Authorization: `Basic ${creds}` } });
  if (!res.ok) return [];
  const data = await res.json();
  return data.resources ?? [];
}

function toItems(icons: CloudinaryResource[]): TierItem[] {
  return icons.map((r) => {
    // Extract filename without extension as display name, e.g. "Koftbullar_ztgwp2" → "Koftbullar"
    const filename = r.public_id.split("/").pop() ?? r.public_id;
    const name = filename.replace(/_[a-z0-9]+$/i, "").replace(/-/g, " ");
    return {
      id: r.public_id,
      name,
      image: `https://res.cloudinary.com/dfxheaozx/image/upload/w_160/${r.public_id}.png`,
      href: null,
    };
  });
}

// One entry per tier list. To add a list, add an entry here with a new
// Cloudinary folder and a unique storageKey. Storage keys must never change,
// or saved rankings are lost.
const lists = [
  {
    key: "nations",
    label: "National dishes",
    eyebrow: "Kaz Cooks Nations",
    intro: "My personal rankings of every national dish I've cooked so far. Drag dishes between tiers — or drop an image file onto any row to add it.",
    footnote: "Click a dish to view the full recipe.",
    prefix: "kaz-mielony/country-icons",
    storageKey: "kaz-tier-v3",
  },
  {
    key: "people",
    label: "People",
    eyebrow: "Kaz Cooks History",
    intro: "My personal rankings of the historical figures featured on the channel. Drag to rank — or drop an image onto any row to add someone new.",
    footnote: "Click a person to view their episode.",
    prefix: "kaz-mielony/people-icons",
    storageKey: "kaz-people-tier-v1",
  },
];

const listsWithItems = await Promise.all(
  lists.map(async (list) => ({ ...list, items: toItems(await fetchIcons(list.prefix)) }))
);
---

<Layout title="Tier Lists" description="Kaz's personal rankings of every national dish and historical figure on the channel.">
  <header class="relative overflow-hidden border-b border-smoke">
    <div class="absolute -top-40 -right-40 w-[34rem] h-[34rem] rounded-full bg-gold/10 blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-10">
      <p id="tier-eyebrow" class="eyebrow">{lists[0].eyebrow}</p>
      <h1 class="mt-4 font-display uppercase text-6xl sm:text-8xl leading-[0.88]">The <span class="text-gold">tier lists</span></h1>
      <p id="tier-intro" class="mt-5 text-lg text-cream/65 max-w-2xl">{lists[0].intro}</p>

      <div class="mt-10 flex flex-wrap gap-2" role="tablist" aria-label="Tier lists">
        {listsWithItems.map((list, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${list.key}`}
            aria-controls={`panel-${list.key}`}
            aria-selected={i === 0 ? "true" : "false"}
            data-tier-tab={list.key}
            data-eyebrow={list.eyebrow}
            data-intro={list.intro}
            class="tier-tab inline-flex items-center gap-2 font-semibold text-sm px-5 py-3 rounded-full ring-1 ring-smoke text-cream/70 hover:text-cream transition-colors"
          >
            {list.label}
            {list.items.length > 0 && <span class="count text-[0.7rem] px-2 py-0.5 rounded-full bg-white/10">{list.items.length}</span>}
          </button>
        ))}
      </div>
    </div>
  </header>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10">
    {listsWithItems.map((list, i) => (
      <section id={`panel-${list.key}`} role="tabpanel" aria-labelledby={`tab-${list.key}`} hidden={i !== 0}>
        <TierList
          id={`tier-${list.key}`}
          storageKey={list.storageKey}
          items={list.items}
          footnote={list.footnote}
          passwordHash={passwordHash}
        />
      </section>
    ))}
  </div>
</Layout>

<style>
  .tier-tab[aria-selected="true"] { background: #e5c074; color: #282828; --tw-ring-color: #e5c074; }
  .tier-tab[aria-selected="true"] .count { background: rgba(40, 40, 40, 0.15); }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tier-tab]')];
  const eyebrow = document.getElementById('tier-eyebrow')!;
  const intro = document.getElementById('tier-intro')!;

  function select(key: string, updateUrl = true) {
    const tab = tabs.find((t) => t.dataset.tierTab === key) ?? tabs[0];
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      document.getElementById(`panel-${t.dataset.tierTab}`)!.hidden = !on;
    });
    eyebrow.textContent = tab.dataset.eyebrow!;
    intro.textContent = tab.dataset.intro!;
    if (updateUrl) history.replaceState(null, '', tab === tabs[0] ? location.pathname : `?list=${tab.dataset.tierTab}`);
  }

  tabs.forEach((t) => t.addEventListener('click', () => select(t.dataset.tierTab!)));
  const initial = new URLSearchParams(location.search).get('list');
  if (initial) select(initial, false);
</script>
